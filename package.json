{
  "name": "olantis",
  "version": "0.1.0",
  "private": true,
  "description": "Olantis personal finance portfolio dashboard",
  "author": "Olantis",
  "scripts": {
    "dev": "next dev",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:smoke": "node scripts/electron-dev.mjs --smoke-test",
    "electron:pack": "electron-builder --dir --publish never",
    "electron:dist": "electron-builder --publish never",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/format.test.mts tests/electron-policy.test.cjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@neondatabase/serverless": "^1.1.0",
    "@workos-inc/authkit-nextjs": "^4.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.37.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "yahoo-finance2": "^4.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.olantis.desktop",
    "productName": "Olantis",
    "asar": true,
    "beforeBuild": "scripts/electron-no-deps.cjs",
    "extraResources": [
      {
        "from": "public/brand/mark-512.png",
        "to": "brand-mark.png"
      }
    ],
    "directories": {
      "app": "electron",
      "output": "release"
    },
    "win": {
      "icon": "public/brand/mark-512.png",
      "target": ["nsis"]
    },
    "mac": {
      "icon": "public/brand/mark-512.png",
      "target": ["dmg", "zip"]
    },
    "linux": {
      "icon": "public/brand/mark-512.png",
      "category": "Finance",
      "maintainer": "Olantis <mtlh@users.noreply.github.com>",
      "target": ["AppImage", "deb"]
    }
  }
}
