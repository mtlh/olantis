{
  "name": "olantis",
  "version": "0.1.0",
  "private": true,
  "description": "Olantis personal finance portfolio dashboard",
  "author": "Olantis",
  "scripts": {
    "dev": "next dev",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:smoke": "node scripts/electron-dev.mjs --smoke-test",
    "electron:pack": "npm --prefix electron ci --no-audit --no-fund && node scripts/run-electron-builder.mjs --dir --publish never",
    "electron:dist": "npm --prefix electron ci --no-audit --no-fund && node scripts/run-electron-builder.mjs --publish never && node scripts/verify-electron-update-manifest.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/format.test.mts tests/backfill.test.mts tests/brands.test.mts tests/electron-policy.test.cjs tests/electron-release.test.cjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@neondatabase/serverless": "^1.1.0",
    "@workos-inc/authkit-nextjs": "^4.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.4",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "yahoo-finance2": "^4.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "build": {
    "appId": "com.olantis.desktop",
    "productName": "Olantis",
    "asar": true,
    "extraResources": [
      {
        "from": "public/brand/mark-512.png",
        "to": "brand-mark.png"
      }
    ],
    "directories": {
      "app": "electron",
      "output": "release"
    },
    "win": {
      "icon": "public/brand/mark-512.png",
      "artifactName": "${productName}.Setup.${version}.${ext}",
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "icon": "public/brand/mark-512.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "icon": "public/brand/mark-512.png",
      "category": "Finance",
      "maintainer": "Olantis <mtlh@users.noreply.github.com>",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mtlh",
        "repo": "olantis",
        "releaseType": "release"
      }
    ]
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.2"
    }
  }
}
